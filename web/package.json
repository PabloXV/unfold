{
	"name": "unfold-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"wasm": "sh scripts/build-wasm.sh",
		"dev": "pnpm wasm && vite dev",
		"build": "pnpm wasm && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm wasm && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "pnpm wasm && node scripts/check-wasm.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
